# --- Client (bundled into the browser build, PUBLIC) ---
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=

# --- Server only (Vercel env vars, NEVER prefixed VITE_) ---
# Read by api/lead.js. Do not put the real secret in .env — that file is
# committed to git. Set these in the Vercel project settings instead.
DASHBOARD_INTAKE_URL=
DASHBOARD_INTAKE_SECRET=
